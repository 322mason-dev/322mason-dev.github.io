<h1 class="h3 fw-bold mb-4">Menu</h1>

<div class="card mb-4">
    <div class="card-body">
        <div class="d-flex flex-wrap gap-2 mb-3">
            <button class="btn btn-outline-success" ng-click="setSection('all')">
                All
            </button>
            <button class="btn btn-outline-success" ng-repeat="section in sections" ng-click="setSection(section.id)">
                {{section.name}}
            </button>
        </div>
        <input type="text" class="form-control" placeholder="Search menu items..." ng-model="searchText">
    </div>
</div>

<div ng-repeat="section in sections" ng-show="sectionVisible(section)">
    <h2 class="h5 fw-bold menu-section-title">
        {{section.name}}
    </h2>
    <div class="row g-3 mt-2">
        <div class="col-md-6" ng-repeat="item in section.items | filter:matchesSearch">
            <div class="card h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-1">
                        <div class="fw-semibold">
                            {{item.name}}
                        </div>
                        <div class="text-muted">
                            ${{item.price | number:2}}
                        </div>
                    </div>
                    <div class="text-muted small">
                        {{item.desc}}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="mt-5">
    <a class="btn btn-outline-primary" href="data/MapleGlenPizzaMenu.pdf" download>
        Download Full Menu (PDF)
    </a>
</div>
